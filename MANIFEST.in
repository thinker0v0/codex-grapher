# Defense in depth: never distribute local runtime state or private key files.
prune .git
prune .venv
prune venv
prune build
prune dist
prune artifacts
prune worktrees
prune secrets
prune .evaluator-private
prune evidence/assessments
exclude config/project-runtime.json
global-exclude *.py[cod] __pycache__ .DS_Store *.pem *.key .env .env.* *.sqlite *.sqlite-* *.db *.db-*

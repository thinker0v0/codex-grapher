# Required model credential (Alibaba Cloud Model Studio international region).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Required for Slack Socket Mode. Use a separate Slack app per Hermes profile.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Comma-separated Slack user IDs. Never leave unrestricted in production.
SLACK_ALLOWED_USERS=

# Comma-separated channel IDs. Set this for every non-evaluator profile.
SLACK_ALLOWED_CHANNELS=

# Optional default destination for scheduled/status messages.
SLACK_HOME_CHANNEL=

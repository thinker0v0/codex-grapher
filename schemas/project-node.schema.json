{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified Adaptive Project Node",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "goal_id", "kind", "dependencies", "write_set", "acceptance", "base_sha", "policy", "evaluator_contract_id"],
  "properties": {
    "node_id": {"type": "string", "minLength": 8},
    "goal_id": {"type": "string", "minLength": 8},
    "kind": {"type": "string", "minLength": 2},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "write_set": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "policy": {"type": "object"},
    "evaluator_contract_id": {"type": "string", "minLength": 1}
  }
}

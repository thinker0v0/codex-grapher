{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-ops:schema:artifact-manifest:v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "attempt", "project_id", "base_sha", "candidate_sha", "producer_identity", "created_at", "contract_sha256", "path_check", "bundle", "required_tests"],
  "properties": {
    "schema_version": {"const": 4},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "project_id": {"enum": ["fin-korea", "oss", "business", "hynix"]},
    "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "producer_identity": {"enum": ["hermes-fin-korea", "hermes-oss", "hermes-business", "hermes-hynix"]},
    "created_at": {"type": "string", "format": "date-time"},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path_check": {"$ref": "#/$defs/nonemptyFile"},
    "bundle": {"$ref": "#/$defs/nonemptyFile"},
    "required_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "command", "candidate_sha", "exit_code", "output"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "command": {"type": "string", "minLength": 1},
          "candidate_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "exit_code": {"type": "integer", "const": 0},
          "output": {"$ref": "#/$defs/file"}
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "not": {"pattern": "(^|/)\\.\\.?(/|$)|//"}
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "nonemptyFile": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {"properties": {"byte_length": {"minimum": 1}}}
      ]
    }
  }
}

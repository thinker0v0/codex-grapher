{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-grapher.local/schemas/repository-checks.schema.json",
  "title": "Repository independent checks v1",
  "description": "Strict UTF-8 JSON, at most 1048576 bytes. Reject duplicate object keys and duplicate check IDs even if their argv values differ. Exact source bytes and ordered argv values must be frozen. Tool authorization and external-program freezing belong to workflow initialization, not schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checks"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "argv"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"},
          "argv": {
            "type": "array", "minItems": 1, "maxItems": 256,
            "items": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S", "not": {"pattern": "\u0000"}}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-ops:schema:task-contract:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "task_id", "requester_identity", "authorization", "idempotency_key", "repo", "base_sha", "objective", "acceptance_criteria", "required_tests", "allowed_paths", "allowed_tools", "forbidden_actions", "budget", "deadline", "timeout_seconds", "max_iterations", "cancellation_token", "builder_identity", "evaluator_contract_id"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": ["string", "null"]},
    "child_task_ids": {"type": "array", "items": {"type": "string"}},
    "requester_identity": {"type": "string", "minLength": 1},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "policy_version", "authorized_at", "expires_at", "subject_sha256", "evidence_sha256", "signature_sha256"],
      "properties": {
        "decision": {"const": "allow"},
        "policy_version": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signature_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 16},
    "repo": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "objective": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_tools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_artifact_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "budget": {"type": "object", "required": ["max_cost_usd", "max_tokens"], "properties": {"max_cost_usd": {"type": "number", "exclusiveMinimum": 0}, "max_tokens": {"type": "integer", "exclusiveMinimum": 0}}},
    "deadline": {"type": "string", "format": "date-time"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 21600},
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 5},
    "retry_of_attempt_id": {"type": ["string", "null"]},
    "supersedes_task_id": {"type": ["string", "null"]},
    "cancellation_token": {"type": "string", "minLength": 16},
    "builder_identity": {"type": "string", "minLength": 1},
    "evaluator_contract_id": {"type": "string", "minLength": 1}
  }
}

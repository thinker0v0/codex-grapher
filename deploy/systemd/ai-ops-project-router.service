[Unit]
Description=Bounded Hermes multi-project router
After=network-online.target ai-ops-controller@fin-korea.service ai-ops-controller@oss.service ai-ops-controller@business.service ai-ops-controller@hynix.service
Wants=ai-ops-controller@fin-korea.service ai-ops-controller@oss.service ai-ops-controller@business.service ai-ops-controller@hynix.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/ai-ops/project-router --socket /run/ai-ops-router/router.sock
Restart=on-failure
RestartSec=3s
RuntimeDirectory=ai-ops-router
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/srv/hermes/fin-korea /srv/hermes/oss /srv/hermes/business /srv/hermes/hynix /var/lib/ai-ops /run/ai-ops-fin-korea /run/ai-ops-oss /run/ai-ops-business /run/ai-ops-hynix /run/ai-ops-router
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
